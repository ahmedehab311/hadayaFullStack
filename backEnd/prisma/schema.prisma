datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum SettingCategory {
  GENERAL
  FINANCIAL
  GIFT
  POLICY
  SYSTEM
  SEO
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT // لسه مدفعش
  PENDING_VERIFICATION // دفع يدوي (فودافون/انستا) ومنتظر تأكيد الأدمن
  PAID // تم الدفع
  PROCESSING // بنجهز الشحنة
  SHIPPED // تم الشحن
  DELIVERED // تم التوصيل
  CANCELLED
  REFUNDED
}

enum DeliveryType {
  SELF // توصيل للمشتري (لنفسه)
  GIFT_DIRECT // توصيل مباشر للمستلم (لشخص تاني)
}

enum PaymentMethod {
  COD // عند الاستلام — SELF بس
  CREDIT_CARD
  VODAFONE_CASH
  INSTAPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GiftTokenStatus {
  PENDING // لم يُرسل/لم يُفتح
  SENT // تم إرسال الرابط
  VIEWED // المستلم شاف الهدية
  COMPLETED // المستلم ملّى العنوان
  EXPIRED
}

model Setting {
  id        String          @id @default(uuid())
  key       String          @unique
  value     String
  type      SettingType     @default(STRING)
  category  SettingCategory @default(GENERAL)
  isPublic  Boolean         @default(true)
  updatedAt DateTime        @updatedAt
  createdAt DateTime        @default(now())
}

model User {
  id        String    @id @default(uuid())
  email     String?   @unique
  password  String?
  name      String?
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  orders    Order[]
  addresses Address[]
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String  @default("المنزل")
  city       String
  street     String
  building   String?
  floor      String?
  apartment  String?
  landmark   String?
  postalCode String?
  phone      String

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ Named relations فقط — كلها ليها اسم واضح
  buyerOrders     Order[]     @relation("BuyerAddress")
  recipientOrders Order[]     @relation("RecipientAddress")
  giftTokens      GiftToken[] @relation("RecipientFilledAddress")
}

model Collection {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  productId String?
  products  Product[] @relation("ProductCollections")

  @@index([slug])
}

model Product {
  id            String  @id @default(uuid())
  slug          String  @unique
  // Multilingual fields
  nameAr        String
  nameEn        String
  descriptionAr String? @db.Text
  descriptionEn String? @db.Text

  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  status         ProductStatus @default(DRAFT)
  stock          Int           @default(0)

  imageUrl String?
  images   String[]

  // Gift options
  isPersonalizable   Boolean @default(false)
  giftMessageEnabled Boolean @default(false)
  attributes         Json?
  isBestSeller       Boolean @default(false)

  // SEO fields
  metaTitle       String?
  metaDescription String?
  // Relations
  items           OrderItem[]
  collections     Collection[] @relation("ProductCollections")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique
  buyerId     String

  deliveryType DeliveryType @default(SELF)

  // ── SELF: العنوان المحفوظ بتاع المشتري ──
  buyerAddressId String?
  buyerAddress   Address? @relation("BuyerAddress", fields: [buyerAddressId], references: [id])

  // ── GIFT_DIRECT: بيانات المستلم ──
  recipientName      String?
  recipientPhone     String?
  recipientEmail     String?
  recipientAddressId String?
  recipientAddress   Address? @relation("RecipientAddress", fields: [recipientAddressId], references: [id])

  status OrderStatus @default(PENDING_VERIFICATION)

  currency        String  @default("EGP")
  subtotal        Decimal @db.Decimal(10, 2)
  deliveryFee     Decimal @default(0) @db.Decimal(10, 2)
  giftWrappingFee Decimal @default(0) @db.Decimal(10, 2)
  greetingCardFee Decimal @default(0) @db.Decimal(10, 2)
  discount        Decimal @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal @db.Decimal(10, 2)

  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(PENDING)
  transactionRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paidAt      DateTime?
  verifiedAt  DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  paymentProof  PaymentProof?
  statusHistory OrderStatusHistory[]
  buyer         User                 @relation(fields: [buyerId], references: [id])
  items         OrderItem[]
  giftToken     GiftToken?

  @@index([buyerId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity        Int     @default(1)
  unitPrice       Decimal @db.Decimal(10, 2) // السعر وقت الشراء
  subtotal        Decimal @db.Decimal(10, 2)
  giftMessage     String? @db.Text
  isGiftWrapped   Boolean @default(false)
  hasGreetingCard Boolean @default(false)

  createdAt DateTime @default(now())
}

model GiftToken {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  token String @unique

  status GiftTokenStatus @default(PENDING)

  notifyMethod String?
  notifiedAt   DateTime?
  viewedAt     DateTime?

  recipientFilledAddressId String?
  recipientFilledAddress   Address? @relation("RecipientFilledAddress", fields: [recipientFilledAddressId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PaymentProof {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  imageUrl String // رابط الصورة على Supabase/S3
  method   PaymentMethod // فودافون ولا إنستا

  // مراجعة الأدمن
  reviewedBy String? // admin user id
  reviewedAt DateTime?
  isVerified Boolean? // true = مقبول, false = مرفوض, null = لسه

  createdAt DateTime @default(now())
}

model OrderStatusHistory {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    OrderStatus
  notes     String? // سبب التغيير
  changedBy String? // user id (أو "system")

  createdAt DateTime @default(now())
}
